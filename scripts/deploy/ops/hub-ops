#!/bin/sh
# hub-ops <mode> [<argument>...], as in docs/features/hub-ops.md "`hub-ops`":
# a hub's dumps off its host (S1-S6), each mode in a container of the image
# whose tool it runs (S2): no Docker socket, no call into another container.
#   queue [once]    dump-queue, the hub's image, no network: every served
#                   project's queue by `spec export state`, one generation
#   door [once]     dump-door, the door's image, no network: `hub-admin dump`
#                   under its lock, one generation
#   upload [once]   backup, restic's image, its own network: the newest
#                   generation of each part to restic; the 03:05 UTC round
#                   forgets and prunes (S6)
#   fresh           backup's healthcheck: a whole upload round, and both
#                   parts' newest generations, within 35 minutes
#   init, snapshots, check, restore DIR [QUEUE DOOR]   backup's acts, by hand
# A loop runs a round at start, then one a slot on a 15-minute UTC grid,
# keeping no state but the clock and the generations' names (S5); a failed
# round is logged and the next slot runs. Plaintext stays on tmpfs (R4):
# the hub-dumps volume and backup's /snapshot and /state. restic_env is read
# line by line, never sourced, and no line this prints holds a secret or one
# of its values (R5). Every path sits under HUB_OPS_ROOT, empty in a
# container, as HUB_ADMIN_ROOT is hub-admin's. POSIX sh: dash, busybox ash,
# macOS's sh; bytes under LC_ALL=C.
set -u
LC_ALL=C
export LC_ALL
umask 077

me=hub-ops
root=${HUB_OPS_ROOT:-}
projects=$root/projects
dumps=$root/dumps
snapshot=$root/snapshot
state=$root/state
ok_file=$state/ok
restic_env=$root/run/secrets/restic_env
hub_admin=$root/opt/hub-admin/hub-admin
# hub-admin's paths follow, unless given apart.
HUB_ADMIN_ROOT=${HUB_ADMIN_ROOT-$root}
export HUB_ADMIN_ROOT

# The grid (S5): 15 minutes, upload 5 minutes after the dumpers, and the
# 03:05 UTC slot the one that prunes (S6).
period=900
upload_offset=300
prune_slot=11100
# upload's first round waits for the dumpers' first ones.
upload_delay=60
keep=3
fresh_minutes=35
tmp_minutes=60
door_retries=12
door_wait=10
# A generation's name: `date -u +%Y%m%dT%H%M%SZ` at its round's start.
gen_glob='[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z'

# ------------------------------------------------------------------ messages

mode=-
stamp=-

# The time of the round or act, as stamp.
now_stamp() {
    stamp=$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null) || stamp=
    [ -n "$stamp" ] || stamp=-
}

say() {
    printf '%s: %s %s: %s\n' "$me" "$mode" "$stamp" "$1" >&2
}

# `$1` with every byte but printable ASCII shown as `?`.
shown() {
    printf '%s' "$1" | tr -c ' -~' '?'
}

# A bad call or a refused setting: exit 2, before anything runs.
bad() {
    say "$1"
    exit 2
}

print_usage() {
    cat >&2 <<'EOF'
usage: hub-ops <mode> [<argument>...]
  queue [once]      door [once]      upload [once]      fresh
  init              snapshots        check              restore DIR [QUEUE DOOR]
EOF
}

usage() {
    say "$1"
    print_usage
    exit 2
}

# ------------------------------------------------------------------ the exit

# The running child, the round's staging folder, its captured output and
# its claim on a generation's name: what a signal stops and removes.
child=
staging=
capture=
claim=

on_signal() {
    trap '' HUP INT TERM
    if [ -n "$child" ]; then
        kill "$child" 2>/dev/null
        wait "$child" 2>/dev/null
        child=
    fi
    if [ -n "$staging" ]; then rm -rf "$staging"; fi
    if [ -n "$capture" ]; then rm -f "$capture"; fi
    if [ -n "$claim" ]; then rmdir "$claim" 2>/dev/null; fi
    exit "$1"
}
trap 'on_signal 129' HUP
trap 'on_signal 130' INT
trap 'on_signal 143' TERM

# "$@" in the background, waited for, so a signal stops a round at once and
# the trap ends the child; its status.
run_child() {
    "$@" &
    child=$!
    wait "$child"
    child_status=$?
    child=
    return "$child_status"
}

pause() {
    run_child sleep "$1"
}

# ------------------------------------------------------------------ checks

# `$1` is a folder that holds nothing, no dot file either; one that cannot
# be listed is not.
is_empty_dir() {
    [ -d "$1" ] || return 1
    entries=$(ls -A -- "$1" 2>/dev/null) || return 1
    [ -z "$entries" ]
}

need_host() {
    [ -n "${HUB_HOST:-}" ] || bad "HUB_HOST is not set: give it in .env"
}

# `$1` is older than `$2` minutes (`find -mmin`); one find cannot judge is.
older_than() {
    aged=$(find "$1" -prune -mmin +"$2" 2>/dev/null) || return 0
    [ -n "$aged" ]
}

# ------------------------------------------------------------------ restic_env

# The keys exported from restic_env, so a later read unsets them first.
env_keys=
cr=$(printf '\r')

# `$1` is an upper-case shell name of at most 64 bytes, as an environment
# variable is: what a refusal may name. A shell name in lower or mixed case
# is not: a base64 secret's body (`...==`) and a hex one are such names.
is_name() {
    case $1 in
        '' | [!ABCDEFGHIJKLMNOPQRSTUVWXYZ_]* | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_]*)
            return 1
            ;;
    esac
    [ "${#1}" -le 64 ]
}

# A refused line of restic_env: its number, and its key only when that is an
# upper-case shell name. Any other part before `=` may be a value pasted
# whole, so nothing of the line is said (R5).
refused_key() {
    if ! is_name "$2"; then
        say "restic_env:$1: not KEY=value"
        return
    fi
    case $2 in
        RESTIC_PASSWORD*)
            say "restic_env:$1: $(shown "$2"): the password is secrets/restic_password, read through RESTIC_PASSWORD_FILE"
            ;;
        *)
            say "restic_env:$1: $(shown "$2"): not a key restic_env takes: RESTIC_REPOSITORY, RESTIC_REST_USERNAME, RESTIC_REST_PASSWORD, or AWS_, B2_, AZURE_, GOOGLE_, OS_ or ST_ then A-Z, 0-9 or _"
            ;;
    esac
}

# Secrets "`restic_env`": one KEY=value a line, empty lines and `#` lines
# skipped, the value the rest of the line verbatim, each key exported for
# restic alone to read. 1 on a refused file, said.
read_env() {
    for key in $env_keys; do unset "$key"; done
    env_keys=
    if [ ! -f "$restic_env" ] || [ ! -r "$restic_env" ]; then
        say "cannot read ${restic_env}: put restic_env in secrets/ beside restic_password"
        return 1
    fi
    line_no=0
    repository_at=0
    while IFS= read -r line || [ -n "$line" ]; do
        line_no=$((line_no + 1))
        case $line in
            '' | '#'*) continue ;;
            *=*) ;;
            *)
                say "restic_env:$line_no: not KEY=value"
                return 1
                ;;
        esac
        key=${line%%=*}
        value=${line#*=}
        case $key in
            RESTIC_REPOSITORY)
                if [ "$repository_at" -ne 0 ]; then
                    say "restic_env:$line_no: RESTIC_REPOSITORY again: it is on line $repository_at"
                    return 1
                fi
                repository_at=$line_no
                ;;
            RESTIC_REST_USERNAME | RESTIC_REST_PASSWORD) ;;
            AWS_* | B2_* | AZURE_* | GOOGLE_* | OS_* | ST_*)
                case $key in
                    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_]*)
                        refused_key "$line_no" "$key"
                        return 1
                        ;;
                esac
                ;;
            *)
                refused_key "$line_no" "$key"
                return 1
                ;;
        esac
        case " $env_keys " in
            *" $key "*)
                say "restic_env:$line_no: $key again: one line a key"
                return 1
                ;;
        esac
        case $value in
            *"$cr")
                say "restic_env:$line_no: $key: the line ends in CR: save restic_env with LF line ends"
                return 1
                ;;
        esac
        export "$key=$value"
        env_keys="$env_keys $key"
    done < "$restic_env"
    if [ "$repository_at" -eq 0 ]; then
        say "restic_env: no RESTIC_REPOSITORY line: name the repository"
        return 1
    fi
}

# The last non-blank line of the file `$1`, every control character shown
# as `?` and every restic_env value as `<KEY>`: what a log may show of it.
# Every byte of every occurrence of any value is covered first, the longest
# values first, overlapping ones too, so no value spoils another's match and
# none shows in part; each covered run then becomes one `<KEY>`, named by the
# longest value covering its first byte.
last_line() {
    HO_KEYS=$env_keys awk '
        NF { last = $0 }
        END {
            n = split(ENVIRON["HO_KEYS"], keys, " ")
            m = 0
            for (i = 1; i <= n; i++) {
                v = ENVIRON[keys[i]]
                if (v == "") continue
                m++
                name[m] = keys[i]
                val[m] = v
            }
            for (i = 1; i <= m; i++)
                for (j = i + 1; j <= m; j++)
                    if (length(val[j]) > length(val[i])) {
                        t = val[i]; val[i] = val[j]; val[j] = t
                        t = name[i]; name[i] = name[j]; name[j] = t
                    }
            len = length(last)
            for (i = 1; i <= m; i++) {
                lv = length(val[i])
                from = 1
                while (from <= len && (p = index(substr(last, from), val[i])) > 0) {
                    at = from + p - 1
                    for (q = at; q < at + lv; q++)
                        if (!(q in cover)) cover[q] = name[i]
                    from = at + 1
                }
            }
            out = ""
            p = 1
            while (p <= len) {
                if (p in cover) {
                    key = cover[p]
                    while (p <= len && (p in cover)) p++
                    out = out "<" key ">"
                    continue
                }
                c = substr(last, p, 1)
                if (c ~ /[[:cntrl:]]/) c = "?"
                out = out c
                p++
            }
            print out
        }' "$1" 2>/dev/null
}

# Each non-blank line of the file `$2` as one of this round's lines,
# labelled `$1`, every control character shown as `?`.
said_lines() {
    HO_PREFIX="$me: $mode $stamp: $1: " awk '
        NF {
            line = $0
            gsub(/[[:cntrl:]]/, "?", line)
            print ENVIRON["HO_PREFIX"] line
        }' "$2" >&2
}

# ------------------------------------------------------------------ generations

# The newest complete generation of the part folder `$1` as newest_gen,
# empty when none: byte order is time order.
newest() {
    newest_gen=
    for gen in "$1"/$gen_glob; do
        if [ -d "$gen" ]; then newest_gen=$gen; fi
    done
}

# A round's start in the part folder `$1`: its time t, its staging made.
begin_round() {
    now_stamp
    t=$stamp
    case $t in
        $gen_glob) ;;
        *)
            say "date -u answered $(shown "$t"), not a generation's name: the round is skipped"
            return 1
            ;;
    esac
    if ! mkdir -p "$1"; then
        say "cannot make ${1}: the round is skipped"
        return 1
    fi
    staging=$1/.$t.$$.tmp
    if ! mkdir "$staging"; then
        say "cannot make the staging ${staging##*/}: the round is skipped"
        staging=
        return 1
    fi
}

# The round's staging and its claim removed: a round that is dropped.
drop_round() {
    say "$1"
    rm -rf "$staging"
    staging=
    if [ -n "$claim" ]; then rmdir "$claim" 2>/dev/null; fi
    claim=
}

# R3: the staging renamed to t only once the round is done, never into a
# generation already there, then the part folder `$1` pruned. The name is
# claimed first by an atomic `mkdir` of `.<t>.claim.tmp`, so two rounds in
# one second, in two containers sharing hub-dumps, never both rename: `mv`
# onto a folder that exists would move the staging into it.
finish_round() {
    target=$1/$t
    if ! mkdir "$1/.$t.claim.tmp" 2>/dev/null; then
        drop_round "$t is claimed by another round: two rounds in one second; this one is dropped"
        return 1
    fi
    claim=$1/.$t.claim.tmp
    if [ -e "$target" ] || [ -L "$target" ]; then
        drop_round "$t exists: two rounds in one second; this one is dropped"
        return 1
    fi
    if ! mv "$staging" "$target"; then
        drop_round "cannot rename the staging to $t: the round is dropped"
        return 1
    fi
    staging=
    rmdir "$claim" 2>/dev/null
    claim=
    prune_part "$1"
}

# The part folder `$1` keeps its newest generations, and any `.*.tmp` younger
# than an hour: another round's, a `run --rm` one's beside the loop's.
prune_part() {
    count=0
    for gen in "$1"/$gen_glob; do
        if [ -d "$gen" ]; then count=$((count + 1)); fi
    done
    for gen in "$1"/$gen_glob; do
        [ "$count" -gt "$keep" ] || break
        [ -d "$gen" ] || continue
        rm -rf "$gen" || say "cannot remove the old generation ${gen##*/}"
        count=$((count - 1))
    done
    for old in "$1"/.*.tmp; do
        [ -e "$old" ] || continue
        if older_than "$old" "$tmp_minutes"; then
            rm -rf "$old" || say "cannot remove the stale ${old##*/}"
        fi
    done
}

# ------------------------------------------------------------------ the rounds

# "A `queue` round": every folder of /projects holding a specengine.toml, in
# byte order (`*` and `[ -d ]`, as specengine-entrypoint), exported into the
# staging; a failed export carries the previous generation's dump (R12).
queue_round() {
    part=$dumps/queue
    begin_round "$part" || return 1
    newest "$part"
    previous=$newest_gen
    capture=$part/.$t.$$.log.tmp
    served=0
    failed=
    for entry in "$projects"/*; do
        [ -d "$entry" ] || continue
        [ -f "$entry/specengine.toml" ] || continue
        name=${entry##*/}
        label=$(shown "$name")
        served=$((served + 1))
        out=$staging/$name.jsonl
        if run_child spec export state --root "$entry" --out "$out" < /dev/null > "$capture" 2>&1; then
            said_lines "$label" "$capture"
            continue
        fi
        code=$child_status
        said_lines "$label" "$capture"
        failed=1
        rm -f "$out" "$out.partial"
        if [ -n "$previous" ] && [ -f "$previous/$name.jsonl" ] && ln "$previous/$name.jsonl" "$out"; then
            say "$label: the export failed (exit $code): carried ${previous##*/}/$label.jsonl"
        else
            say "$label: the export failed (exit $code): no earlier dump to carry"
        fi
        printf '%s\n' "$name" >> "$staging/CARRIED" || say "cannot write CARRIED"
    done
    rm -f "$capture"
    capture=
    if [ "$served" -eq 0 ]; then
        say "no folder of /projects holds a specengine.toml: nothing dumped"
        rm -rf "$staging"
        staging=
        return 1
    fi
    finish_round "$part" || return 1
    if [ -n "$failed" ]; then
        say "dumped $served project(s) into $t, an older dump carried: see CARRIED"
        return 1
    fi
    say "dumped $served project(s) into $t"
}

# "A `door` round": `hub-admin dump` into the staging, retried 12 times 10 s
# apart while it fails (the lock held, R8), then skipped. A dump that timed
# out (hub-admin's DUMP_BOUND) is not tried again: the round fails.
door_round() {
    part=$dumps/door
    begin_round "$part" || return 1
    capture=$part/.$t.$$.log.tmp
    retries=0
    until run_child /bin/sh "$hub_admin" dump "$staging" < /dev/null > "$capture" 2>&1; do
        said=$(last_line "$capture")
        case $said in
            *"the dump timed out"*) retries=$door_retries ;;
        esac
        if [ "$retries" -ge "$door_retries" ]; then
            say "skipped: $said"
            rm -rf "$staging"
            staging=
            rm -f "$capture"
            capture=
            return 1
        fi
        retries=$((retries + 1))
        if ! { rm -rf "$staging" && mkdir "$staging"; }; then
            say "cannot empty the staging ${staging##*/}: the round is skipped"
            rm -rf "$staging"
            staging=
            rm -f "$capture"
            capture=
            return 1
        fi
        pause "$door_wait"
    done
    dumped=$(last_line "$capture")
    rm -f "$capture"
    capture=
    finish_round "$part" || return 1
    say "$dumped"
}

# restic `$2`... for the round's line labelled `$1`, its output caught on
# tmpfs and its last line said; 1 on any exit but 0.
restic_round() {
    label=$1
    shift
    run_child restic "$@" < /dev/null > "$capture" 2>&1
    code=$child_status
    last=$(last_line "$capture")
    case $code in
        0)
            if [ -n "$last" ]; then say "$label: $last"; fi
            return 0
            ;;
        10) say "$label: the repository is not initialised: run docker compose run --rm backup init" ;;
        12) say "$label: the repository password is wrong" ;;
        *) say "$label: restic $1 failed (exit $code)${last:+: $last}" ;;
    esac
    return 1
}

# "An `upload` round", `$1` non-empty in the 03:05 UTC one: the newest
# complete generation of each part copied to /snapshot and sent; the round
# is whole when each was there, young and carrying nothing, and every
# restic call answered 0. Only a whole round touches /state/ok.
upload_round() {
    prunes=$1
    now_stamp
    whole=1
    read_env || return 1
    if ! mkdir -p "$snapshot" "$state"; then
        say "cannot make /snapshot or /state: the round is skipped"
        return 1
    fi
    capture=$state/.upload.$$.log.tmp
    for name in queue door; do
        newest "$dumps/$name"
        gen=$newest_gen
        if [ -z "$gen" ]; then
            say "$name: no complete generation in /dumps/$name: is dump-$name running?"
            whole=
            continue
        fi
        gen_name=${gen##*/}
        if older_than "$gen" "$fresh_minutes"; then
            say "$name: the newest generation $gen_name is older than $fresh_minutes minutes: is dump-$name running?"
            whole=
        fi
        if [ -e "$gen/CARRIED" ]; then
            carried=$(awk 'NF { gsub(/[[:cntrl:]]/, "?"); printf "%s%s", sep, $0; sep = " " }' "$gen/CARRIED" 2>/dev/null)
            say "$name: $gen_name holds CARRIED: the older dump of ${carried:-a project} is carried, its export failed"
            whole=
        fi
        # -p: the files keep the dump's times, and a restore gives them back.
        if ! { rm -rf "${snapshot:?}/$name" && cp -Rp "$gen" "$snapshot/$name"; }; then
            say "$name: cannot copy $gen_name to /snapshot/$name"
            whole=
            continue
        fi
        restic_round "$name" backup --host "$HUB_HOST" --tag "$name" "$snapshot/$name" || whole=
    done
    if [ -n "$prunes" ]; then
        for name in queue door; do
            restic_round "$name" forget --host "$HUB_HOST" --tag "$name" --keep-within 48h --keep-daily 30 ||
                whole=
        done
        restic_round prune prune || whole=
    fi
    rm -f "$capture"
    capture=
    if [ -z "$whole" ]; then
        say "not whole"
        return 1
    fi
    if ! touch "$ok_file"; then
        say "cannot touch /state/ok: not whole"
        return 1
    fi
    say "whole"
}

# The loop: the round `$1` at every slot of the grid offset by `$2`
# seconds, recomputed from the clock after each round (R10); the round is
# given 1 in the 03:05 UTC slot.
loop() {
    while :; do
        now=$(date -u +%s 2>/dev/null) || now=
        case $now in
            '' | *[!0123456789]*)
                say "date -u +%s answered $(shown "$now"): the next round is in $period s"
                pause "$period"
                continue
                ;;
        esac
        slot=$((now - (now - $2) % period + period))
        pause $((slot - now))
        if [ $((slot % 86400)) -eq "$prune_slot" ]; then
            "$1" 1
        else
            "$1" ""
        fi
    done
}

# ------------------------------------------------------------------ the acts

# restic "$@" for an act run by hand, its output the operator's; 0, or 1
# said.
restic_act() {
    run_child restic "$@"
    code=$child_status
    case $code in
        0) return 0 ;;
        10) say "the repository is not initialised: run docker compose run --rm backup init" ;;
        12) say "the repository password is wrong" ;;
        *) say "restic $1 failed (exit $code)" ;;
    esac
    return 1
}

# One snapshot ID: `latest` or restic's hex.
check_id() {
    case $1 in
        latest) return 0 ;;
        '' | *[!0123456789abcdef]*) ;;
        *) [ "${#1}" -ge 8 ] && [ "${#1}" -le 64 ] && return 0 ;;
    esac
    bad "restore: $(shown "$1") is not a snapshot ID: give latest or the IDs backup snapshots lists"
}

# "`restore`": the two parts into DIR/queue and DIR/door; only `latest`
# filters by the host and the part's tag.
act_restore() {
    [ "$#" -eq 1 ] || [ "$#" -eq 3 ] || usage "restore takes DIR, or DIR QUEUE DOOR"
    dir=$1
    queue_id=${2:-latest}
    door_id=${3:-latest}
    check_id "$queue_id"
    check_id "$door_id"
    case "$queue_id $door_id" in
        *latest*) need_host ;;
    esac
    [ -d "$dir" ] || bad "restore: $(shown "$dir") is not a folder: give an existing empty folder"
    is_empty_dir "$dir" || bad "restore: $(shown "$dir") is not empty: give an existing empty folder"
    read_env || exit 2
    for name in queue door; do
        if [ "$name" = queue ]; then id=$queue_id; else id=$door_id; fi
        if [ "$id" = latest ]; then
            set -- --host "$HUB_HOST" --tag "$name"
        else
            set --
        fi
        restic_act restore "$id:$snapshot/$name" "$@" --target "$dir/$name" || return 1
    done
    say "restored the queue into $(shown "$dir")/queue and the door into $(shown "$dir")/door"
}

# backup's health: a whole round within 35 minutes, and each part's newest
# generation in /dumps younger than that, so a stopped dumper shows within
# one interval of its generation ageing (HO5), not only once the rounds it
# spoils have aged /state/ok too. The age is find's -mmin, as the rounds'.
act_fresh() {
    [ "$#" -eq 0 ] || usage "fresh takes no argument"
    fresh=1
    if [ ! -f "$ok_file" ] || older_than "$ok_file" "$fresh_minutes"; then
        say "no whole round within $fresh_minutes minutes: docker compose logs dump-queue dump-door backup say why"
        fresh=
    fi
    for name in queue door; do
        newest "$dumps/$name"
        if [ -z "$newest_gen" ]; then
            say "$name: no complete generation in /dumps/$name: is dump-$name running?"
            fresh=
        elif older_than "$newest_gen" "$fresh_minutes"; then
            say "$name: the newest generation ${newest_gen##*/} is older than $fresh_minutes minutes: is dump-$name running?"
            fresh=
        fi
    done
    if [ -z "$fresh" ]; then exit 1; fi
    say "a whole round, and both parts dumped, within $fresh_minutes minutes"
    exit 0
}

# ------------------------------------------------------------------ the modes

now_stamp
[ "$#" -ge 1 ] || usage "give a mode"
mode=$(shown "$1")
shift
case $mode in
    queue | door | upload)
        once=
        case $# in
            0) ;;
            1)
                [ "$1" = once ] || usage "$mode takes once or nothing, not $(shown "$1")"
                once=1
                ;;
            *) usage "$mode takes once or nothing" ;;
        esac
        ;;
esac
case $mode in
    queue)
        if [ -n "$once" ]; then
            queue_round
            exit
        fi
        queue_round
        loop queue_round 0
        ;;
    door)
        if [ -n "$once" ]; then
            door_round
            exit
        fi
        door_round
        loop door_round 0
        ;;
    upload)
        need_host
        read_env || exit 2
        if [ -n "$once" ]; then
            upload_round ""
            exit
        fi
        pause "$upload_delay"
        upload_round ""
        loop upload_round "$upload_offset"
        ;;
    fresh) act_fresh "$@" ;;
    init)
        [ "$#" -eq 0 ] || usage "init takes no argument"
        read_env || exit 2
        restic_act init
        exit
        ;;
    snapshots)
        [ "$#" -eq 0 ] || usage "snapshots takes no argument"
        need_host
        read_env || exit 2
        restic_act snapshots --host "$HUB_HOST"
        exit
        ;;
    check)
        [ "$#" -eq 0 ] || usage "check takes no argument"
        read_env || exit 2
        restic_act check
        exit
        ;;
    restore)
        act_restore "$@"
        exit
        ;;
    *) usage "an unknown mode: $mode" ;;
esac
