# The door's cookie domain: a domain for the hub alone (Q6).
HUB_DOMAIN=example.org
# The daemon's --public-origin is https://$HUB_HOST.
HUB_HOST=hub.example.org
# Authelia's portal, a sibling subdomain.
DOOR_HOST=login.example.org
ACME_EMAIL=ops@example.org
# Staging first; production after the dry run.
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# The plugin's version (S7): the image tag.
SPECENGINE_VERSION=0.52.1
# 1 turns on --push, after the gate (RM-0074).
SPECENGINE_PUSH=0
# The slow-line threshold in ms (--slow-ms), 0 to 3600000; 0 writes a line
# for every request. Unset: the daemon's 2000. Set it for a measurement
# session only, then remove it and run `docker compose up -d` again.
# SPECENGINE_SLOW_MS=0
# The blob store's caps in bytes (work-references); they only lower the caps
# or raise the floor. Unset: 268435456 a file, 10737418240 a project, and
# 5368709120 kept free.
# SPECENGINE_BLOB_FILE_MAX=
# SPECENGINE_BLOB_QUOTA=
# SPECENGINE_BLOB_FLOOR=
